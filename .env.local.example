# ─────────────────────────────────────────────────────────────
# Elara AI — Environment Variables Template
# Copy this file to `.env.local` and fill in your real values.
# NEVER commit `.env.local` (it is git-ignored).
# ─────────────────────────────────────────────────────────────

# Supabase — PUBLIC (safe for the browser; protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — SERVER ONLY (never expose to the browser, never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site origin — used to build Google OAuth / email-confirmation redirect URLs.
# Must match the Supabase "Site URL" and your Google redirect URI origin.
# Change this to your deployed origin before testing OAuth/email links in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# AssemblyAI — Real-time speech-to-text (Phase 2, Voice Brain)
#
# SERVER ONLY. Never prefix with NEXT_PUBLIC_.
#
# The browser never sees this key: `app/api/voice/token/route.ts` exchanges it
# for a short-lived, single-use streaming token and hands only that to the
# client. Get one at https://www.assemblyai.com/dashboard
# ─────────────────────────────────────────────────────────────
ASSEMBLYAI_API_KEY=your-assemblyai-api-key

# ─────────────────────────────────────────────────────────────
# Main Brain — Day 2 (Phase 2)
#
# ALL SERVER ONLY. Never prefix with NEXT_PUBLIC_.
#
# GROQ_API_KEY powers four of the five critical-path steps:
#   input safety    → llama-prompt-guard-2-86m
#   main response   → gpt-oss-120b
#   reorganize      → qwen3.8-27b
#   output safety   → gpt-oss-safeguard-20b
# (llama-guard-4-20b is NOT used: it 404s on Groq.)
# Without it the brain speaks a safe "not configured" line instead of a reply.
# Get one at https://console.groq.com/keys
#
# GOOGLE_AI_API_KEY (Google AI Studio) powers:
#   - fast assist: Gemini 3.5 Flash Lite (hard-capped at 800 ms, optional)
#   - background: Gemini Embedding 2 + gemma-4-31b-it quality check
# Optional — those steps skip silently when absent.
#
# BRIGHTDATA_* powers live web search (Bright Data SERP). Optional — when
# absent, the model answers from its own knowledge and live-fact turns get the
# model's best memory answer instead of a fresh lookup.
# EXACT NAMES the code reads (lib/brain/env.ts):
#   BRIGHTDATA_SERP_TOKEN  — your Bright Data API / SERP token
#   BRIGHTDATA_SERP_ZONE   — the zone id provisioned for SERP scraping
# Both are required together; if either is missing, search is inert.
#
# OLLAMA_API_KEY powers the stage-3 fallback + background long-context
# (nemotron-3-nano on Ollama Cloud). Optional — skips silently when absent.
# ─────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key
GOOGLE_AI_API_KEY=your-google-ai-studio-api-key
BRIGHTDATA_SERP_TOKEN=your-brightdata-serp-token
BRIGHTDATA_SERP_ZONE=your-brightdata-serp-zone
OLLAMA_API_KEY=your-ollama-cloud-api-key
OLLAMA_BASE_URL=https://ollama.com